    "test": "vitest run"
  },
  "dependencies": {
    "@linktree/types": "workspace:*",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.562.0",
    "motion": "^12.42.2",
    "next": "^16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vitest": "^5.0.0"
  }
