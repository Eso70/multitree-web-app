{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:maplibre": "node scripts/sync-maplibre-worker.mjs",
    "sync:env": "node scripts/sync-env.mjs",
    "predev": "pnpm run sync:env && pnpm run sync:maplibre",
    "prebuild": "pnpm run sync:env && pnpm run sync:maplibre",
    "prestart": "pnpm run sync:env",
    "prestart:prod": "pnpm run sync:env",
    "dev": "next dev --webpack -p 3011",
    "build": "next build",
    "start": "next start -p 3011",
    "start:prod": "cross-env NODE_ENV=production next start -p 3011",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@linktree/types": "workspace:*",
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.42.2",
    "next": "^16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
