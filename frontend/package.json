{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:env": "node scripts/sync-env.mjs",
    "predev": "pnpm run sync:env",
    "prebuild": "pnpm run sync:env",
    "prestart": "pnpm run sync:env",
    "prestart:prod": "pnpm run sync:env",
    "dev": "next dev --webpack -p 3011",
    "build": "next build",
    "start": "next start -p 3011",
