{
  "apps": [
    {
      "name": "multitree-backend",
      "cwd": "./backend",
      "script": "dist/src/main.js",
      "instances": 2,
      "exec_mode": "cluster",
      "env": {
        "NODE_ENV": "production",
        "PORT": "4000"
      },
      "env_file": "../.env",
      "watch": false,
      "autorestart": true,
      "max_restarts": 10,
      "restart_delay": 5000,
      "error_file": "./logs/backend-error.log",
      "out_file": "./logs/backend-out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z"
    },
    {
      "name": "multitree-frontend",
      "cwd": "./frontend",
      "script": "node_modules/next/dist/bin/next",
      "args": "start -p 3011 -H 0.0.0.0",
      "instances": 2,
      "exec_mode": "cluster",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3011",
        "HOSTNAME": "0.0.0.0"
      },
      "env_file": "../.env",
      "watch": false,
      "autorestart": true,
      "max_restarts": 10,
      "restart_delay": 5000,
      "error_file": "./logs/frontend-error.log",
      "out_file": "./logs/frontend-out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z"
    }
  ]
}
