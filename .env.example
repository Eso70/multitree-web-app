# MultiTree environment template
# Copy this file to `.env` and replace every placeholder secret.
# `frontend/.env` is generated from the root `.env`; do not edit it manually.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multitree
DB_MAINTENANCE_NAME=postgres
DB_RESET_REQUIRE_STOPPED_BACKEND=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000
DB_USER=postgres
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Security
# Use separate random values of at least 32 characters for every secret.
SESSION_SECRET=
API_KEY_PEPPER=
APP_ENCRYPTION_KEY=
REQUEST_TRACKING_SECRET=
OPERATIONS_SECRET=
ANALYTICS_HASH_SECRET=

# Request telemetry
REQUEST_LOG_RETENTION_DAYS=30
REQUEST_LOG_BATCH_SIZE=250
REQUEST_LOG_FLUSH_INTERVAL_MS=250
REQUEST_LOG_MAX_QUEUE_SIZE=50000
REQUEST_LOG_CLEANUP_BATCH_SIZE=10000
REQUEST_LOG_CLEANUP_MAX_BATCHES=100

# Application
NODE_ENV=development
PORT=4000
ROOT_DOMAIN=lvh.me:3011
APP_BASE_URL=http://lvh.me:3011
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3011
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://lvh.me:3011
PLATFORM_ADMIN_PATH=
MAX_FILE_SIZE_MB=10
# UPLOAD_DIR=/var/lib/multitree/uploads

# Browser origins
CORS_ORIGIN=http://localhost:3011,http://lvh.me:3011,http://*.lvh.me:3011
CORS_ALLOWED_ORIGINS=http://lvh.me:3011,http://localhost:3011
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,lvh.me,*.lvh.me

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://lvh.me:3011/api/auth/google/callback

# Business invitations
SIGNUP_INVITATION_TTL_HOURS=24

# Email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
# For Gmail, use an App Password rather than the Google account password.
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=MultiTree

# Initial platform administrator
# Authentication uses Google or an emailed code; no administrator password is stored.
PLATFORM_ADMIN_USERNAME=multitree-admin
PLATFORM_ADMIN_NAME=MultiTree
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PHONE=7500000000
PLATFORM_ADMIN_WEBSITE_COLOR="#b6f20d"
PLATFORM_ADMIN_LOGO_WITH_BACKGROUND=/images/Logo.jpg
PLATFORM_ADMIN_LOGO_WITHOUT_BACKGROUND=/images/multitree-logo-mark.png
PLATFORM_ADMIN_FAVICON=/favicon.ico
