# ============================================
# Environment Configuration
# ============================================
# Copy this file to .env at the project root:
#   cp .env.example .env
#
# This root file is the single source of truth for both applications.
#
# The backend reads it directly. Next.js only reads env files from its own
# package directory, so `frontend/.env` is GENERATED from this file by
# frontend/scripts/sync-env.mjs, which runs automatically before `dev`,
# `build`, and `start`. It copies only the keys the frontend actually reads;
# database, Redis, SMTP, OAuth, and administrator credentials never leave the
# backend's environment. Never edit `frontend/.env` by hand.
#
# Do NOT commit the actual .env - it contains secrets.
#
# Values below are the LOCAL DEVELOPMENT defaults. Every setting that differs
# in production is marked with a "Production:" comment.
# ============================================

# ============================================
# DATABASE (PostgreSQL) - used by backend
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multitree
# Administrative database used by db:migrate and db:reset.
DB_MAINTENANCE_NAME=postgres
# Optional: require the backend to be stopped before db:reset.
DB_RESET_REQUIRE_STOPPED_BACKEND=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ============================================
# REDIS - used by backend (sessions, cache, queues)
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ============================================
# SESSION SECRET - used by backend
# ============================================
# Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=your_long_random_secret_here_at_least_32_chars
# Dedicated HMAC pepper for developer API keys.
API_KEY_PEPPER=replace_with_a_different_random_secret_at_least_32_chars
# Optional dedicated AES key for pending approval and integration secrets.
# Falls back to SESSION_SECRET during rollout; use a distinct 32+ character key in production.
APP_ENCRYPTION_KEY=replace_with_a_different_random_secret_at_least_32_chars

# Server-to-server key used by Next.js to submit frontend request telemetry.
# Generate a separate random value with: openssl rand -hex 32
REQUEST_TRACKING_SECRET=replace_with_a_different_random_secret_at_least_32_chars
# Protects readiness and operational metrics. Use a distinct random value in production.
OPERATIONS_SECRET=replace_with_an_operations_secret_at_least_32_chars
ANALYTICS_HASH_SECRET=replace_with_a_different_random_secret_at_least_32_chars
# Request telemetry is automatically deleted after this many days.
REQUEST_LOG_RETENTION_DAYS=30
REQUEST_LOG_BATCH_SIZE=250
REQUEST_LOG_FLUSH_INTERVAL_MS=250
REQUEST_LOG_MAX_QUEUE_SIZE=50000
REQUEST_LOG_CLEANUP_BATCH_SIZE=10000
REQUEST_LOG_CLEANUP_MAX_BATCHES=100

# ============================================
# BACKEND SERVER
# ============================================
PORT=4000
NODE_ENV=development

# ============================================
# CORS - backend allows requests from this origin
# ============================================
# Comma-separated list of fully-qualified origins (scheme + host + port)
# the browser is allowed to call the API from. Each entry may be an exact
# origin or a `*` subdomain wildcard. Add every origin users log in from.
#
# Local dev uses lvh.me, a public DNS name that resolves to 127.0.0.1 for
# itself and every subdomain, so business subdomain routing works locally
# without editing the hosts file. Plain http, because there is no local TLS.
CORS_ORIGIN=http://localhost:3011,http://lvh.me:3011,http://*.lvh.me:3011
# Production: CORS_ORIGIN=https://sponsor.krd,https://*.sponsor.krd

# Optional comma-separated origin list for frontend response headers.
# Falls back to ALLOWED_DEV_ORIGINS when unset. The first entry is used as
# the Access-Control-Allow-Origin value, so list the canonical origin first.
CORS_ALLOWED_ORIGINS=http://lvh.me:3011,http://localhost:3011
# Production: CORS_ALLOWED_ORIGINS=https://sponsor.krd

# ============================================
# FRONTEND (Next.js)
# ============================================
# Backend API URL (used by Next.js server-side & client-side)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production: NEXT_PUBLIC_API_URL=https://sponsor.krd
# In production the browser must reach the API through the same public origin,
# because Caddy proxies /api/* to the backend and cookies are origin-scoped.

# App URL (used for generating absolute linktree URLs)
NEXT_PUBLIC_APP_URL=http://lvh.me:3011
# Production: NEXT_PUBLIC_APP_URL=https://sponsor.krd

# Private browser route for the Platform Administrator console. Generate a
# different long random value for every hosted environment. This is an extra
# concealment layer, not a replacement for authentication or authorization.
PLATFORM_ADMIN_PATH=/replace-with-at-least-20-random-characters

# ============================================
# DEV ORIGINS - Next.js dev server (comma-separated)
# ============================================
# Only needed in development. Add your local network IP if testing from devices.
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,lvh.me,*.lvh.me

# ============================================
# IMAGE UPLOAD - used by backend
# ============================================
MAX_FILE_SIZE_MB=10
# Optional: override the default upload directory
# Optional absolute local-storage path. Default: <repository>/.runtime/uploads
# Keep this outside frontend/public so uploads do not trigger Next.js rebuilds.
# UPLOAD_DIR=/var/lib/multitree/uploads

# ============================================
# ROOT DOMAIN - used by backend and frontend for subdomain routing
# ============================================
# The base domain for subdomain-based business routing.
# Cookie domain is scoped to .{subdomain}.{ROOT_DOMAIN}
#
# In development this includes the frontend port so generated URLs are
# reachable. Host comparisons strip the port (backend/src/common/root-domain.ts),
# so a port here is safe. In production it is the bare domain.
ROOT_DOMAIN=lvh.me:3011
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3011
APP_BASE_URL=http://lvh.me:3011
# Production:
#   ROOT_DOMAIN=sponsor.krd
#   NEXT_PUBLIC_ROOT_DOMAIN=sponsor.krd
#   APP_BASE_URL=https://sponsor.krd

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must match an Authorized redirect URI on the Google OAuth client exactly,
# including scheme. Register the local and production URIs on the same client.
GOOGLE_OAUTH_REDIRECT_URI=http://lvh.me:3011/api/auth/google/callback
# Production: GOOGLE_OAUTH_REDIRECT_URI=https://sponsor.krd/api/auth/google/callback
SIGNUP_INVITATION_TTL_HOURS=24
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
# Gmail: use a Google App Password, never the account password.
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=MultiTree

# ============================================
# INITIAL PLATFORM ADMINISTRATOR
# Used by the backend seed on first run.
#
# These were previously named SA_*. The old names are still read as a
# fallback so an existing .env keeps working, but they are deprecated:
# set the PLATFORM_ADMIN_* name and remove the SA_* one when convenient.
# When both are present the PLATFORM_ADMIN_* value wins.
# ============================================
PLATFORM_ADMIN_USERNAME=multitree-admin
PLATFORM_ADMIN_NAME=MultiTree
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PHONE=7500000000
PLATFORM_ADMIN_WEBSITE_COLOR="#b6f20d"
PLATFORM_ADMIN_LOGO_WITH_BACKGROUND=/images/Logo.jpg
PLATFORM_ADMIN_LOGO_WITHOUT_BACKGROUND=/images/DefaultAvatar.png
PLATFORM_ADMIN_FAVICON=/favicon.ico
